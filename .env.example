# Create a local .env file and paste your Gemini API key below.
# Never put this value in a VITE_* variable; those are exposed to the browser.
GEMINI_API_KEY=your-gemini-api-key-here

# Stable, fast, structured-output model available on the Gemini free tier.
GEMINI_MODEL=gemini-3.5-flash-lite

# Express API port. Vite proxies /api requests here during development.
PORT=3001
